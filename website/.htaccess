Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Force HTTPS with fixed canonical hostname (prevents Host Header Injection)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://flow.mdsdev.ru%{REQUEST_URI} [L,R=301]

    # Block access to hidden files/directories (except .well-known for Let's Encrypt)
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

# Block direct downloads of deployment archives, keys, backups, logs, and cache files
<FilesMatch "\.(zip|tar|gz|tgz|7z|rar|bak|backup|old|orig|sql|sqlite|db|log|cache|key|pem|env|ini|sh|ps1|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://update.flow.mdsdev.ru; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
</IfModule>
